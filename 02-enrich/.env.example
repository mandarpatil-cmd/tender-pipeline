# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Key: https://openrouter.ai/keys
# Models: https://openrouter.ai/models

OPENROUTER_API_KEY=
MODEL=google/gemini-2.5-flash

# Let the model search the web before answering. Leave this on.
#
# Off, it answers from its weights alone -- and a small regional contractor is
# simply not in them. The first live run returned null for every vendor that
# had no work-order PDF to go on.
#
# Searching is billed per result, on top of the model's own tokens. The number
# of results per call is settings.WEB_SEARCH_RESULTS.
WEB_SEARCH=1
