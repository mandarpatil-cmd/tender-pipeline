# Copy to `.env` (never commit `.env`).
#
# Stage 1 talks to exactly one external service: OpenRouter, and only to read
# the 6-character search captcha. Finding vendor contact details belongs to
# stage 2 (`02-enrich`), which has its own `.env`.

# --- OpenRouter (captcha OCR) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Vision model that reads the captcha. Must accept images.
# OPENROUTER_OCR_MODEL=google/gemini-2.5-flash

# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Sent as the HTTP-Referer and X-Title headers, which is how OpenRouter
# attributes usage. Defaults shown.
# OPENROUTER_HTTP_REFERER=https://localhost
# OPENROUTER_APP_TITLE=eprocure-aoc
