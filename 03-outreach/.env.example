# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Optional seed for the first saved letter ---
# The Mail page is where the letter and signature are edited after that.
# These values are copied once, into an empty database. They are not the From address.
# SENDER_ORG for this campaign: Policy Pact Insurance Broker
SENDER_NAME=
SENDER_DESIGNATION=
SENDER_ORG=
SENDER_MOBILE=
SENDER_EMAIL=

# --- Outlook (TRANSPORT = "outlook" in main.py, the default) ---
# The Microsoft 365 mailbox and its password. With MFA on, use an app password.
# The tenant must allow SMTP AUTH -- see "Using Outlook" in README.md.
# OUTLOOK_USER is also the preflight recipient for "graph" below.
OUTLOOK_USER=
OUTLOOK_PASSWORD=

# --- Outlook via Microsoft Graph (TRANSPORT = "graph", the fallback) ---
# From an Entra app registration -- see "Using Microsoft Graph" in README.md.
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=

# --- Gmail (TRANSPORT = "gmail" in main.py) ---
# GMAIL_APP_PASSWORD is a 16-character app password, not your account password:
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on)
GMAIL_USER=
GMAIL_APP_PASSWORD=
