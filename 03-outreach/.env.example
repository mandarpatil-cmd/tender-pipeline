# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Who signs every message (required for a live send) ---
SENDER_NAME=
SENDER_ORG=

# --- Gmail (TRANSPORT = "gmail" in main.py, the default) ---
# GMAIL_APP_PASSWORD is a 16-character app password, not your account password:
# https://myaccount.google.com/apppasswords (needs 2-Step Verification on)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Microsoft 365 (TRANSPORT = "graph" in main.py) ---
# From an Entra app registration -- see "Using Microsoft Graph" in README.md.
GRAPH_CLIENT_ID=
GRAPH_TENANT_ID=
OUTLOOK_USER=
